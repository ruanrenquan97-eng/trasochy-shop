    "alipay-sdk": "^4.14.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^5.7.284",
    "quill": "^2.0.3",
    "react-quill-new": "^3.8.3",
