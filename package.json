  "main": "index.js",
  "scripts": {
    "dev:server": "nodemon --exec ts-node -r tsconfig-paths/register server/src/index.ts",
    "dev:client": "cd client && npm run dev",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run db:studio\"",
    "db:studio": "npx drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
